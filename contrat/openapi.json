{
  "components": {
    "schemas": {
      "AccesNominatif": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z_]+\\.[a-z_]+\\.[a-z_]+$",
            "title": "Code",
            "type": "string"
          },
          "fin": {
            "description": "Date scolaire de fin, incluse",
            "format": "date",
            "title": "Fin",
            "type": "string"
          }
        },
        "required": [
          "code",
          "fin"
        ],
        "title": "AccesNominatif",
        "type": "object"
      },
      "Administrateur": {
        "additionalProperties": false,
        "description": "Qui peut attribuer ses domaines à une personne sans capacité : l'écran le nomme.",
        "properties": {
          "nom": {
            "minLength": 1,
            "title": "Nom",
            "type": "string"
          },
          "prenoms": {
            "minLength": 1,
            "title": "Prenoms",
            "type": "string"
          },
          "telephone": {
            "description": "Au format du pack, jamais vide",
            "minLength": 1,
            "title": "Telephone",
            "type": "string"
          }
        },
        "required": [
          "nom",
          "prenoms",
          "telephone"
        ],
        "title": "Administrateur",
        "type": "object"
      },
      "AlerteContexte": {
        "additionalProperties": false,
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "gravite": {
            "$ref": "#/components/schemas/Gravite"
          },
          "type": {
            "$ref": "#/components/schemas/CodeNeutre_A-Z__A-Z0-9______"
          }
        },
        "required": [
          "type",
          "gravite",
          "details"
        ],
        "title": "AlerteContexte",
        "type": "object"
      },
      "AnneeContexte": {
        "additionalProperties": false,
        "properties": {
          "etat": {
            "$ref": "#/components/schemas/EtatAnnee"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "libelle": {
            "minLength": 1,
            "title": "Libelle",
            "type": "string"
          }
        },
        "required": [
          "id",
          "libelle",
          "etat"
        ],
        "title": "AnneeContexte",
        "type": "object"
      },
      "CapaciteContexte": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "domaine.objet.verbe",
            "pattern": "^[a-z_]+\\.[a-z_]+\\.[a-z_]+$",
            "title": "Code",
            "type": "string"
          },
          "perimetre": {
            "additionalProperties": {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            "description": "Listes d'identifiants nommées `*_ids`",
            "title": "Perimetre",
            "type": "object"
          }
        },
        "required": [
          "code",
          "perimetre"
        ],
        "title": "CapaciteContexte",
        "type": "object"
      },
      "CodeNeutre": {
        "type": "string"
      },
      "CodeNeutre_A-Z__A-Z0-9______": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "Compte": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "langue": {
            "description": "Code de langue à deux lettres",
            "pattern": "^[a-z]{2}$",
            "title": "Langue",
            "type": "string"
          },
          "nom": {
            "minLength": 1,
            "title": "Nom",
            "type": "string"
          },
          "prenoms": {
            "minLength": 1,
            "title": "Prenoms",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nom",
          "prenoms",
          "langue"
        ],
        "title": "Compte",
        "type": "object"
      },
      "ContexteCapacites": {
        "additionalProperties": false,
        "description": "Une seule requête au démarrage : tout ce qu'il faut pour ne rendre que ce qui existe.",
        "properties": {
          "acces_nominatifs": {
            "items": {
              "$ref": "#/components/schemas/AccesNominatif"
            },
            "title": "Acces Nominatifs",
            "type": "array"
          },
          "alertes": {
            "items": {
              "$ref": "#/components/schemas/AlerteContexte"
            },
            "title": "Alertes",
            "type": "array"
          },
          "annee_active": {
            "format": "uuid",
            "title": "Annee Active",
            "type": "string"
          },
          "annees": {
            "items": {
              "$ref": "#/components/schemas/AnneeContexte"
            },
            "minItems": 1,
            "title": "Annees",
            "type": "array"
          },
          "capacites": {
            "items": {
              "$ref": "#/components/schemas/CapaciteContexte"
            },
            "title": "Capacites",
            "type": "array"
          },
          "compte": {
            "$ref": "#/components/schemas/Compte"
          },
          "country_pack": {
            "$ref": "#/components/schemas/CountryPackContexte"
          },
          "etablissement_actif": {
            "format": "uuid",
            "title": "Etablissement Actif",
            "type": "string"
          },
          "etablissements": {
            "items": {
              "$ref": "#/components/schemas/EtablissementContexte"
            },
            "minItems": 1,
            "title": "Etablissements",
            "type": "array"
          },
          "parametres_effectifs": {
            "additionalProperties": true,
            "title": "Parametres Effectifs",
            "type": "object"
          }
        },
        "required": [
          "compte",
          "etablissements",
          "etablissement_actif",
          "annees",
          "annee_active",
          "capacites",
          "acces_nominatifs",
          "country_pack",
          "parametres_effectifs",
          "alertes"
        ],
        "title": "ContexteCapacites",
        "type": "object"
      },
      "CorpsPoserParametre": {
        "additionalProperties": false,
        "properties": {
          "portee": {
            "$ref": "#/components/schemas/Portee"
          },
          "portee_id": {
            "format": "uuid",
            "title": "Portee Id",
            "type": "string"
          },
          "valeur": {
            "$ref": "#/components/schemas/ValeurParametre"
          }
        },
        "required": [
          "portee",
          "portee_id",
          "valeur"
        ],
        "title": "CorpsPoserParametre",
        "type": "object"
      },
      "CountryPackContexte": {
        "additionalProperties": false,
        "properties": {
          "decoupage": {
            "$ref": "#/components/schemas/CodeNeutre_A-Z__A-Z0-9______"
          },
          "devise": {
            "$ref": "#/components/schemas/Devise"
          },
          "langues": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Langues",
            "type": "array"
          },
          "pays": {
            "pattern": "^[A-Z]{2}$",
            "title": "Pays",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          },
          "vocabulaire": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "description": "Codes neutres de docs/02-domaine.md § 15, un libellé par langue du pack",
            "propertyNames": {
              "$ref": "#/components/schemas/CodeNeutre"
            },
            "title": "Vocabulaire",
            "type": "object"
          }
        },
        "required": [
          "pays",
          "version",
          "devise",
          "langues",
          "decoupage",
          "vocabulaire"
        ],
        "title": "CountryPackContexte",
        "type": "object"
      },
      "Devise": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z]{3}$",
            "title": "Code",
            "type": "string"
          },
          "exposant": {
            "description": "Nombre de chiffres de l'unité mineure",
            "maximum": 4,
            "minimum": 0,
            "title": "Exposant",
            "type": "integer"
          },
          "symbole": {
            "description": "Ce que l'interface écrit après un montant",
            "minLength": 1,
            "title": "Symbole",
            "type": "string"
          }
        },
        "required": [
          "code",
          "exposant",
          "symbole"
        ],
        "title": "Devise",
        "type": "object"
      },
      "EnveloppeErreur": {
        "description": "docs/03-api.md § 1.6 — `code` est ce que le client teste, jamais `message`.",
        "properties": {
          "champ": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Champ"
          },
          "code": {
            "description": "Stable, préfixé par domaine",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "De quoi construire l'issue — pour `VAL_SCHEMA_INVALIDE`, `champs` est une liste de `{chemin, motif}`",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Français, factuel, destiné au journal — pas affiché tel quel",
            "title": "Message",
            "type": "string"
          },
          "requete_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "L'`X-Nelo-Requete` reçu ; `null` si la requête n'en portait pas",
            "title": "Requete Id"
          }
        },
        "required": [
          "code",
          "message",
          "champ",
          "details",
          "requete_id"
        ],
        "title": "EnveloppeErreur",
        "type": "object"
      },
      "EtablissementContexte": {
        "additionalProperties": false,
        "properties": {
          "administrateur": {
            "$ref": "#/components/schemas/Administrateur"
          },
          "cycles_actifs": {
            "items": {
              "$ref": "#/components/schemas/CodeNeutre"
            },
            "title": "Cycles Actifs",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "modules_actifs": {
            "items": {
              "$ref": "#/components/schemas/CodeNeutre"
            },
            "title": "Modules Actifs",
            "type": "array"
          },
          "nom": {
            "minLength": 1,
            "title": "Nom",
            "type": "string"
          },
          "sites": {
            "items": {
              "$ref": "#/components/schemas/Site"
            },
            "title": "Sites",
            "type": "array"
          }
        },
        "required": [
          "id",
          "nom",
          "sites",
          "cycles_actifs",
          "modules_actifs",
          "administrateur"
        ],
        "title": "EtablissementContexte",
        "type": "object"
      },
      "EtatAnnee": {
        "enum": [
          "PREPARATION",
          "ACTIVE",
          "CLOTUREE",
          "ARCHIVEE"
        ],
        "type": "string"
      },
      "Gravite": {
        "enum": [
          "INFO",
          "ALERTE",
          "CRITIQUE"
        ],
        "type": "string"
      },
      "ParametreEffectif": {
        "properties": {
          "cle": {
            "title": "Cle",
            "type": "string"
          },
          "portee_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portee Id"
          },
          "portee_resolue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Portee"
              },
              {
                "type": "null"
              }
            ],
            "description": "La portée à laquelle la valeur a été trouvée ; `null` si aucune valeur n'est posée"
          },
          "source": {
            "enum": [
              "VALEUR",
              "DEFAUT",
              "NON_DEFINIE"
            ],
            "title": "Source",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TypeParametre"
          },
          "valeur": {
            "$ref": "#/components/schemas/ValeurParametre",
            "description": "La valeur brute, typée par le catalogue. Un DECIMAL voyage en chaîne."
          }
        },
        "required": [
          "cle",
          "type",
          "valeur",
          "portee_resolue",
          "portee_id",
          "source"
        ],
        "title": "ParametreEffectif",
        "type": "object"
      },
      "ParametrePose": {
        "properties": {
          "cle": {
            "title": "Cle",
            "type": "string"
          },
          "portee": {
            "$ref": "#/components/schemas/Portee"
          },
          "portee_id": {
            "format": "uuid",
            "title": "Portee Id",
            "type": "string"
          },
          "pose_le": {
            "format": "date-time",
            "title": "Pose Le",
            "type": "string"
          },
          "valeur": {
            "$ref": "#/components/schemas/ValeurParametre"
          }
        },
        "required": [
          "cle",
          "portee",
          "portee_id",
          "valeur",
          "pose_le"
        ],
        "title": "ParametrePose",
        "type": "object"
      },
      "Portee": {
        "enum": [
          "TENANT",
          "ETABLISSEMENT",
          "SITE",
          "CYCLE"
        ],
        "title": "Portee",
        "type": "string"
      },
      "ReponseParametres": {
        "properties": {
          "etablissement_id": {
            "format": "uuid",
            "title": "Etablissement Id",
            "type": "string"
          },
          "parametres": {
            "items": {
              "$ref": "#/components/schemas/ParametreEffectif"
            },
            "title": "Parametres",
            "type": "array"
          }
        },
        "required": [
          "etablissement_id",
          "parametres"
        ],
        "title": "ReponseParametres",
        "type": "object"
      },
      "ReponseSante": {
        "properties": {
          "etat": {
            "const": "OK",
            "title": "Etat",
            "type": "string"
          }
        },
        "required": [
          "etat"
        ],
        "title": "ReponseSante",
        "type": "object"
      },
      "Site": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nom": {
            "minLength": 1,
            "title": "Nom",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nom"
        ],
        "title": "Site",
        "type": "object"
      },
      "TypeParametre": {
        "enum": [
          "ENTIER",
          "DECIMAL",
          "BOOLEEN",
          "CHAINE",
          "PLAGE_HORAIRE"
        ],
        "title": "TypeParametre",
        "type": "string"
      },
      "ValeurParametre": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "info": {
    "title": "Nelo — API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/parametres": {
      "get": {
        "operationId": "lire_parametres",
        "parameters": [
          {
            "description": "UUID de l'établissement actif. Lu par un middleware — absent ou malformé, `400 TEN_ETABLISSEMENT_REQUIS` ; inconnu, `404 TEN_RESSOURCE_INTROUVABLE`. Résolution provisoire du tenant jusqu'à T1a.",
            "in": "header",
            "name": "X-Nelo-Etablissement",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseParametres"
                }
              }
            },
            "description": "Chaque clé du catalogue, sa valeur effective et la portée où elle a été résolue"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`TEN_ETABLISSEMENT_REQUIS` — en-tête absent ou malformé, refusé par le middleware"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`TEN_RESSOURCE_INTROUVABLE` — ressource inexistante dans le périmètre du tenant ; jamais `403`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`API_ERREUR_INTERNE` — aucun détail technique dans `message` ; `requete_id` suffit à retrouver la trace"
          }
        },
        "summary": "Paramètres effectifs du catalogue, résolus à la portée de l'établissement de l'en-tête"
      }
    },
    "/parametres/{cle}": {
      "put": {
        "operationId": "poser_parametre",
        "parameters": [
          {
            "description": "UUID de l'établissement actif. Lu par un middleware — absent ou malformé, `400 TEN_ETABLISSEMENT_REQUIS` ; inconnu, `404 TEN_RESSOURCE_INTROUVABLE`. Résolution provisoire du tenant jusqu'à T1a.",
            "in": "header",
            "name": "X-Nelo-Etablissement",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "UUID v7 généré par le client. Lu par un middleware — absent, `400 REQUETE_CLE_MANQUANTE` ; pas un UUID v7, `400 REQUETE_CLE_INVALIDE`. La réponse est mémorisée 24 h, bornée au tenant.",
            "in": "header",
            "name": "X-Nelo-Requete",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cle",
            "required": true,
            "schema": {
              "title": "Cle",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorpsPoserParametre"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParametrePose"
                }
              }
            },
            "description": "Valeur posée — une écriture qui ne crée rien de nouveau au sens du contrat (UPSERT)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "Refusé par un middleware, avant toute validation : `REQUETE_CLE_MANQUANTE`, `REQUETE_CLE_INVALIDE`, `TEN_ETABLISSEMENT_REQUIS`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`TEN_RESSOURCE_INTROUVABLE` — ressource inexistante dans le périmètre du tenant ; jamais `403`"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`REQUETE_REJOUEE_DIFFEREMMENT` (même clé, corps différent) · `REQUETE_EN_COURS` (même clé, première exécution non terminée)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "Deux natures, un statut, distinguées par `code` : `VAL_SCHEMA_INVALIDE` (corps invalide, `details.champs` liste le chemin de chaque champ fautif) — ou règle métier sur un corps valide : `TEN_PARAMETRE_INCONNU`, `TEN_PORTEE_INVALIDE`, `TEN_VALEUR_INVALIDE`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnveloppeErreur"
                }
              }
            },
            "description": "`API_ERREUR_INTERNE` — aucun détail technique dans `message` ; `requete_id` suffit à retrouver la trace"
          }
        },
        "summary": "Poser une valeur à une portée — capacité `tenant.parametre.definir` (point d'insertion jusqu'à T1b)"
      }
    },
    "/sante": {
      "get": {
        "operationId": "sante",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseSante"
                }
              }
            },
            "description": "Le serveur est levé"
          }
        },
        "summary": "Sonde publique — sans authentification, sans donnée"
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}
