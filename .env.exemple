# Variables lues par api/configuration.py (préfixe NELO_) et par les scripts.
# Copier en `.env` : aucune valeur ici n'est un secret de production.

# Ports publiés par compose.yml sur le poste — à changer si un autre projet les occupe,
# en changeant les URL ci-dessous avec eux.
NELO_PORT_POSTGRES=5432
NELO_PORT_VALKEY=6379
NELO_PORT_GARAGE_S3=3900
NELO_PORT_GARAGE_ADMIN=3903

# L'application n'accède à la base que par le rôle nelo_app (NOSUPERUSER, NOBYPASSRLS).
NELO_BD_URL=postgresql+asyncpg://nelo_app:nelo_app@localhost:5432/nelo
# Les migrations s'exécutent sous le rôle propriétaire des schémas.
NELO_BD_URL_PROPRIETAIRE=postgresql+asyncpg://nelo_proprietaire:nelo_proprietaire@localhost:5432/nelo
NELO_VALKEY_URL=valkey://localhost:6379/0

# Le travailleur d'événements, dans le processus du serveur.
NELO_TRAVAILLEUR_INTERVALLE_MS=500
NELO_TRAVAILLEUR_DELAI_ARRET_MS=10000    # à l'arrêt, le tour en cours finit ; au-delà, il est annulé

# Les trois dépendances externes simulées : SUCCES, ACCUSE_EN_RETARD, ACCUSE_EN_DOUBLE,
# JAMAIS_RECU, INDISPONIBLE.
NELO_SIMULATION_SMS_MODE=SUCCES
NELO_SIMULATION_PAIEMENT_MODE=SUCCES
NELO_SIMULATION_INFERENCE_MODE=SUCCES
NELO_SIMULATION_DELAI_MS=100
